# Postgres
DATABASE_URL="postgresql://srm:srm@localhost:5432/srm?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="change-me"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GOOGLE_WORKSPACE_DOMAIN="codea.bg"

# Google Workspace integration (Gmail + Calendar)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/google/callback"
# 32-byte key, base64-encoded, encrypts GoogleToken.encryptedBlob at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# OCR provider (FIN-3, open question per PRD §14 Q6) — not integrated yet;
# invoice review fields are filled in by hand until this epic is picked up.
OCR_PROVIDER="openai" # or "document-ai"
OPENAI_API_KEY=""

# Finance file storage (FIN-1/4) — local disk under a Docker volume in
# docker-compose.yml; defaults to ./.data/storage outside Docker.
FILE_STORAGE_ROOT="/data/storage"
